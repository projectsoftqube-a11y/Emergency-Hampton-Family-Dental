# Copy this file to .env.local and fill in the values.
# .env.local is gitignored - never commit real credentials.

# ─── Where this landing page is deployed ───
# Used for canonical tags, Open Graph URLs and JSON-LD @id.
# Set this to the real campaign URL before launch.
NEXT_PUBLIC_SITE_URL=https://emergency.hamptonfamilydentist.com

# ─── Review annotations ───
# The [CONFIRM] / [DEV] notes from the client review draft render as amber
# notes on the page. Must stay false on anything taking paid traffic - set it
# to true only for an internal review pass.
NEXT_PUBLIC_LP_REVIEW_NOTES=false

# ─── SMTP for the enquiry form ───
# Mailbox is on Microsoft 365 (Outlook), managed via GoDaddy.
SMTP_HOST=smtp.office365.com
# Microsoft 365 uses 587 with STARTTLS
SMTP_PORT=587
# The mailbox login - the full email address
SMTP_USER=info@hamptonfamilydentist.com
# App Password generated from the Microsoft account. NOT the normal login password.
SMTP_PASS=your-app-password-here

# The "from" address shown on the email (often the same as SMTP_USER)
SMTP_FROM=info@hamptonfamilydentist.com
SMTP_FROM_NAME=Hampton Family Dental Website

# Where enquiry submissions are delivered
ENQUIRY_TO=info@hamptonfamilydentist.com
